<?xml version="1.0"?>
<Container version="2">
  <Name>BoardGameCompanion</Name>
  <Repository>ghcr.io/golgoth85/boardgamecompanion:latest</Repository>
  <Registry>https://ghcr.io/golgoth85/boardgamecompanion</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/golgoth85/boardgamecompanion/issues</Support>
  <Project>https://github.com/golgoth85/boardgamecompanion</Project>
  <Overview>Self-hosted board-game collection, rulebook and RAG companion.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8787]/</WebUI>
  <Shell>bash</Shell>
  <Config Name="WebUI" Target="8787" Default="8787" Mode="tcp" Description="BoardGameCompanion HTTP port" Type="Port" Display="always" Required="true" Mask="false">8787</Config>
  <Config Name="Appdata" Target="/config" Default="/mnt/user/appdata/boardgamecompanion" Mode="rw" Description="Configuration and database" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/boardgamecompanion</Config>
  <Config Name="Import" Target="/data/import" Default="/mnt/user/boardgames/import" Mode="rw" Description="BGG CSV import folder" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/boardgames/import</Config>
  <Config Name="Manuals" Target="/data/manuals" Default="/mnt/user/boardgames/manuals" Mode="rw" Description="Rulebook archive" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/boardgames/manuals</Config>
  <Config Name="RAG Provider (legacy default)" Target="BGC_RAG_PROVIDER" Default="ollama" Mode="" Description="Legacy default provider: ollama, lmstudio or gemini. Independent provider variables override it." Type="Variable" Display="advanced" Required="false" Mask="false">ollama</Config>
  <Config Name="Embedding Provider" Target="BGC_EMBEDDING_PROVIDER" Default="" Mode="" Description="Optional independent embedding provider: ollama, lmstudio or gemini" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Generation Provider" Target="BGC_GENERATION_PROVIDER" Default="" Mode="" Description="Optional independent generation provider: ollama, lmstudio or gemini" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="LM Studio URL" Target="BGC_LMSTUDIO_URL" Default="" Mode="" Description="LM Studio server base URL, for example http://192.168.1.249:1234" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="LM Studio API Key" Target="BGC_LMSTUDIO_API_KEY" Default="" Mode="" Description="Optional LM Studio API token" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="LM Studio Embedding Model" Target="BGC_LMSTUDIO_EMBEDDING_MODEL" Default="" Mode="" Description="LM Studio embedding model identifier" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="LM Studio Generation Model" Target="BGC_LMSTUDIO_GENERATION_MODEL" Default="" Mode="" Description="LM Studio chat model identifier" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="LM Studio Generation Timeout" Target="BGC_LMSTUDIO_GENERATION_TIMEOUT_SECONDS" Default="300" Mode="" Description="Generation timeout in seconds; allow extra time for JIT model loading" Type="Variable" Display="advanced" Required="false" Mask="false">300</Config>
  <Config Name="Gemini API Key" Target="BGC_GEMINI_API_KEY" Default="" Mode="" Description="Google Gemini API auth key. Keep masked and never commit it." Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Gemini Embedding Model" Target="BGC_GEMINI_EMBEDDING_MODEL" Default="gemini-embedding-2" Mode="" Description="Gemini embedding model identifier" Type="Variable" Display="advanced" Required="false" Mask="false">gemini-embedding-2</Config>
  <Config Name="Gemini Embedding Dimensions" Target="BGC_GEMINI_EMBEDDING_DIMENSIONS" Default="768" Mode="" Description="Gemini embedding output dimensionality" Type="Variable" Display="advanced" Required="false" Mask="false">768</Config>
  <Config Name="Gemini Generation Model" Target="BGC_GEMINI_GENERATION_MODEL" Default="gemini-3.8-flash" Mode="" Description="Gemini generation model identifier" Type="Variable" Display="advanced" Required="false" Mask="false">gemini-3.8-flash</Config>
  <Config Name="Ollama URL" Target="BGC_OLLAMA_URL" Default="" Mode="" Description="Optional Ollama URL" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Qdrant URL" Target="BGC_QDRANT_URL" Default="" Mode="" Description="Optional Qdrant URL" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
</Container>
